---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../site.config';

interface Props {
  /** On essay pages the left side becomes a way back, and the name moves to the center. */
  essay?: boolean;
}

const { essay = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class:list={['site-header', { essay }]}>
  {essay && <a class="back" href="/writing/">← Back to writing</a>}
  <a class="name" href="/"><span class="mark" aria-hidden="true"></span>{site.name}</a>
  <nav aria-label="Main">
    <ul>
      {
        site.nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4) var(--gutter);
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 1.625rem;
    font-style: italic;
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) 40px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .back {
    display: inline-block;
    padding-block: 12px;
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: var(--hairline) solid transparent;
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--wood);
  }

  /* Essay pages: back link left, name centered, nav right. */
  @media (min-width: 64rem) {
    .essay {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .essay nav {
      justify-self: end;
    }
  }

  @media (max-width: 64rem) {
    .essay .back {
      order: 2;
    }
    .essay nav {
      order: 3;
    }
  }

  /* Phones: the links collapse under the name in one quiet row. */
  @media (max-width: 40rem) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
    nav,
    ul {
      gap: 0 var(--space-3);
    }
    .essay .back {
      order: 3;
    }
    .essay nav {
      order: 2;
    }
  }
</style>
