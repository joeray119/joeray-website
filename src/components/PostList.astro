---
// A writing list: rows separated by hairlines, never cards.
// `rows` (the Writing page): date | title and topic | reading time, the whole row one link.
// `stacked` (Home): meta, a heading-sized title and a one-line summary.
import { formatMonth, readingTime, type Post } from '../lib/writing';

interface Props {
  posts: Post[];
  variant?: 'rows' | 'stacked';
}

const { posts, variant = 'rows' } = Astro.props;
---

<ol class:list={['posts', variant]}>
  {
    posts.map((post) => {
      const date = <time class="meta" datetime={post.data.date.toISOString()}>{formatMonth(post.data.date)}</time>;
      const minutes = readingTime(post.body);
      return (
        <li data-reveal>
          {variant === 'rows' ? (
            <a class="row" href={`/writing/${post.id}/`}>
              {date}
              <span class="t">
                <span class="title">{post.data.title}</span>
                {post.data.topic && <span class="topic">{post.data.topic}</span>}
              </span>
              <span class="meta read">{minutes} min</span>
            </a>
          ) : (
            <a class="entry" href={`/writing/${post.id}/`}>
              <span class="meta">
                {date}
                <span aria-hidden="true"> · </span>
                {minutes} min read
              </span>
              <span class="title">{post.data.title}</span>
              {post.data.description && <span class="summary">{post.data.description}</span>}
            </a>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Rows */
  .rows li {
    border-top: var(--hairline) solid var(--rule);
  }
  .rows li:last-child {
    border-bottom: var(--hairline) solid var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) 90px;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: 30px;
  }

  .t {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .row .title {
    font-size: 1.875rem;
    line-height: 1.2;
  }

  .topic {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--accent);
  }

  .read {
    text-align: right;
  }

  @media (max-width: 40rem) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-1) var(--space-2);
      padding-block: var(--space-3);
    }
    .row .t {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .row .title {
      font-size: 1.5rem;
    }
  }

  /* Stacked (Home) */
  .stacked li + li {
    margin-top: var(--space-9);
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .entry .title {
    font-size: var(--heading-2);
    line-height: 1.2;
    text-wrap: balance;
  }

  .summary {
    font-size: var(--body-sm);
    line-height: 1.7;
    color: var(--ink-muted);
  }
</style>
