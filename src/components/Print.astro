---
// An image hung like a framed print: a thin wood frame around a soft mat.
// Usage: <Print src={image} alt="…" caption="…" />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}

const { src, alt, caption, width, height } = Astro.props;
---

<figure class="print" data-reveal>
  {
    typeof src === 'string' ? (
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    ) : (
      <Image src={src} alt={alt} width={width} height={height} />
    )
  }
  {caption && <figcaption class="label">{caption}</figcaption>}
</figure>

<style>
  figure {
    margin-inline: 0;
  }
</style>
