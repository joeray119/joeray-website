---
// An image hung like a print: a square wood frame, the one shadow in the system,
// and an optional caption below.
// Usage: <Print src={image} alt="…" caption="…" />  (add `small` for a 12px frame)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
  small?: boolean;
}

const { src, alt, caption, width, height, small = false } = Astro.props;
---

<figure class:list={['print', { small }]} data-reveal>
  <div class="frame">
    {
      typeof src === 'string' ? (
        <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      ) : (
        <Image src={src} alt={alt} width={width} height={height} />
      )
    }
  </div>
  {caption && <figcaption class="meta">{caption}</figcaption>}
</figure>

<style>
  figure {
    margin: var(--space-6) 0;
  }
  figcaption {
    margin-top: var(--space-2);
  }
</style>
