---
import Base from '../layouts/Base.astro';
---

<Base title="Lost in the fog">
  <section class="column lost">
    <p class="label">404</p>
    <h1>Lost in the fog.</h1>
    <p class="lede">This path doesn't lead anywhere. No harm done.</p>
    <p><a class="text-link" href="/">Back to the clearing →</a></p>
  </section>
</Base>

<style>
  .lost {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  h1 {
    margin: var(--space-2) 0 var(--space-3);
  }
</style>
