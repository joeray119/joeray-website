---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/writing';

const recent = (await getPosts()).slice(0, 3);
---

<Base>
  <section class="threshold">
    <p class="label">Hello, I'm Joe</p>
    <h1>Stay a while.</h1>
    <p class="lede">
      This is a quiet corner of the internet: a place for notes, works in progress, and the
      occasional longer piece of writing. There's nothing to sign up for and nothing to scroll past.
    </p>
  </section>

  <section class="section" aria-labelledby="desk-heading">
    <div class="section-label" data-reveal>
      <p class="label">01 · On the desk</p>
      <span class="hair"></span>
    </div>
    <div>
      <h2 id="desk-heading" data-reveal>Recent writing.</h2>
      {
        recent.length > 0 ? (
          <PostList posts={recent} variant="stacked" />
        ) : (
          <p class="muted">Nothing here yet. Soon.</p>
        )
      }
      <p class="more" data-reveal><a class="text-link" href="/writing/">All writing →</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="now-heading">
    <div class="section-label" data-reveal>
      <p class="label">02 · Right now</p>
      <span class="hair"></span>
    </div>
    <div data-reveal>
      <h2 id="now-heading">Pull up a chair.</h2>
      <p>A short, honest note about what has my attention these days. Less a résumé, more a look at the desk.</p>
      <p class="more"><a class="text-link" href="/now/">What I'm working on →</a></p>
    </div>
  </section>
</Base>

<style>
  /* Weighted bottom-left: the words settle low, the top-right stays open like sky. */
  .threshold {
    min-height: clamp(28rem, 72vh, 48rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-inline: var(--gutter);
    max-width: calc(960px + var(--gutter) * 2);
  }

  .threshold p {
    margin: 0;
  }

  h1 {
    font-size: var(--display-xl);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: var(--space-3) 0 var(--space-6);
  }

  .lede {
    max-width: var(--measure);
  }

  .more {
    margin: var(--space-6) 0 0;
  }
</style>
