---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatMonth, readingTime, type Post } from '../../lib/writing';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  older?: Post;
}

const { post, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body);
---

<Base title={post.data.title} description={post.data.description} essay>
  <article class="column post">
    <header>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatMonth(post.data.date)}</time>
        <span aria-hidden="true"> · </span>
        {minutes} min read
        {post.data.topic && <><span aria-hidden="true"> · </span><span class="topic">{post.data.topic}</span></>}
      </p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="lede">{post.data.description}</p>}
    </header>

    <div class="prose">
      <Content />
    </div>

    <div class="ends" aria-hidden="true">
      <span class="mark"></span><span class="mark"></span><span class="mark"></span>
    </div>

    <nav class="after" aria-label="More writing">
      <p class="label">Thanks for staying a while</p>
      {
        older && (
          <p class="older">
            <span class="meta">Older</span>
            <a href={`/writing/${older.id}/`}>{older.data.title}</a>
          </p>
        )
      }
      <a class="text-link" href="/writing/">More from the desk →</a>
    </nav>
  </article>
</Base>

<style>
  .post header {
    padding-block: clamp(4rem, 12vw, 9rem) var(--space-9);
  }
  .post h1 {
    margin: var(--space-2) 0 var(--space-3);
  }
  .post .lede {
    margin: 0;
  }
  .topic {
    color: var(--accent);
  }

  /* Three wood diamonds mark the end of an essay. */
  .ends {
    display: flex;
    gap: 18px;
    margin-top: var(--space-9);
    padding-left: 4px;
  }
  .ends .mark {
    width: 7px;
    height: 7px;
  }

  .after {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .after p {
    margin: 0;
  }
  .older {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: var(--body-sm);
  }
</style>
