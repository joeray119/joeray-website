---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/writing';

const posts = await getPosts();
---

<Base title="Writing" description="Essays and notes, written slowly.">
  <section class="page">
    <header class="column">
      <p class="label">{posts.length} {posts.length === 1 ? 'piece' : 'pieces'}</p>
      <h1>Writing</h1>
      <p class="lede">Essays and notes, written slowly. Take your time.</p>
    </header>
    <div class="list">
      {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">Nothing here yet. Soon.</p>}
    </div>
  </section>
</Base>

<style>
  .page header {
    padding-block: clamp(4rem, 12vw, 9rem) var(--space-9);
  }
  .page h1 {
    margin: var(--space-2) 0 var(--space-3);
  }
  .lede {
    margin: 0;
  }
  .list {
    max-width: calc(960px + var(--gutter) * 2);
    padding-inline: var(--gutter);
    margin-left: clamp(0px, 16vw - 4rem, 18rem);
  }
  @media (max-width: 40rem) {
    .list {
      margin-left: 0;
    }
  }
</style>
